{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=[DB_HOST];Port=[DB_PORT];Username=[DB_USERNAME];Password=[DB_PASSWORD];Database=[DB_NAME];"
  },
  "Cors": {
    "AllowedOrigins": "[CORS_ALLOWED_ORIGINS]"
  },
  "Keycloak": {
    "Authority": "[KEYCLOAK_AUTHORITY_URL]",
    "Client": "[KEYCLOAK_CLIENT_ID]",
    "Secret": "[KEYCLOAK_CLIENT_SECRET]",
    "KcIdpHint": "[KEYCLOAK_IDP_HINT]",
    "RefreshThreshold": "00:05:00"
  },
  "Chefs": {
    "BaseUrl": "[CHEFS_BASE_URL]",
    "Forms": {
      "legal": {
        "FormId": "[CHEFS_FORM_LEGAL_FORMID]",
        "ApiKey": "[CHEFS_FORM_LEGAL_API_KEY]"
      },
      "nonlegal": {
        "FormId": "[CHEFS_FORM_NONLEGAL_FORMID]",
        "ApiKey": "[CHEFS_FORM_NONLEGAL_API_KEY]"
      },
      "form-prequalifying-survey": {
        "FormId": "[CHEFS_FORM_PREQUALIFYING_SURVEY_FORMID]",
        "ApiKey": "[CHEFS_FORM_PREQUALIFYING_SURVEY_API_KEY]",
        "Order": 0,
        "Title": "Survey Questions",
        "Icon": "list-check"
      },
      "form-deceased": {
        "FormId": "[CHEFS_FORM_DECEASED_FORMID]",
        "ApiKey": "[CHEFS_FORM_DECEASED_API_KEY]",
        "Order": 1,
        "Title": "Deceased",
        "Icon": "skull",
        "Children": [
          { "Key": "form-deceased", "Order": 0, "Title": "Information About Deceased" }
        ]
      },
      "form-testamentary-docs": {
        "FormId": "[CHEFS_FORM_TESTAMENTARY_DOCS_FORMID]",
        "ApiKey": "[CHEFS_FORM_TESTAMENTARY_DOCS_API_KEY]",
        "Order": 2,
        "Title": "Deceased's Will",
        "Icon": "book",
        "Children": [
          { "Key": "form-testamentary-docs", "Order": 0, "Title": "Deceased's Will" }
        ]
      },
      "form-related-people": {
        "FormId": "[CHEFS_FORM_RELATED_PEOPLE_FORMID]",
        "ApiKey": "[CHEFS_FORM_RELATED_PEOPLE_API_KEY]",
        "Order": 3,
        "Title": "Related People",
        "Icon": "users",
        "Children": [
          { "Key": "form-spouse", "Order": 0, "Title": "Spouse" },
          { "Key": "form-children", "Order": 1, "Title": "Children", "Disabled": true },
          { "Key": "form-creditors", "Order": 2, "Title": "Creditors", "Disabled": true }
        ]
      },
      "form-applicant": {
        "FormId": "[CHEFS_FORM_APPLICANT_FORMID]",
        "ApiKey": "[CHEFS_FORM_APPLICANT_API_KEY]",
        "Order": 4,
        "Title": "Applicant",
        "Icon": "user-tie",
        "Children": [
          { "Key": "form-applicant-information", "Order": 0, "Title": "Information About Applicant" },
          { "Key": "form-citor", "Order": 1, "Title": "Citor", "Disabled": true },
          { "Key": "form-applicant-service", "Order": 2, "Title": "Applicant Service" }
        ]
      },
      "form-notify": {
        "FormId": "[CHEFS_FORM_NOTIFY_FORMID]",
        "ApiKey": "[CHEFS_FORM_NOTIFY_API_KEY]",
        "Order": 5,
        "Title": "Notify",
        "Icon": "envelope-open-text",
        "Children": [
          { "Key": "form-full-review", "Order": 0, "Title": "Review Your Answers" },
          { "Key": "form-tell-people", "Order": 1, "Title": "Tell People You Are Applying" },
          { "Key": "form-preview-p1", "Order": 2, "Title": "Preview P1" },
          { "Key": "form-preview-pgt", "Order": 3, "Title": "Preview PGT" },
          { "Key": "form-notify-people", "Order": 4, "Title": "Notify People" }
        ]
      },
      "form-assets": {
        "FormId": "[CHEFS_FORM_ASSETS_FORMID]",
        "ApiKey": "[CHEFS_FORM_ASSETS_API_KEY]",
        "Order": 6,
        "Title": "Assets",
        "Icon": "coins",
        "Children": [
          { "Key": "form-assets-details", "Order": 0, "Title": "Assets Details" }
        ]
      },
      "form-application-documents": {
        "FormId": "[CHEFS_FORM_APPLICATION_DOCUMENTS_FORMID]",
        "ApiKey": "[CHEFS_FORM_APPLICATION_DOCUMENTS_API_KEY]",
        "Order": 7,
        "Title": "Application Documents",
        "Icon": "file-lines",
        "Children": [
          { "Key": "form-preview-p9", "Order": 0, "Title": "Preview P9" },
          { "Key": "form-fill-p5", "Order": 1, "Title": "Fill out a Form P5" },
          { "Key": "form-fill-p10", "Order": 2, "Title": "Fill out a Form P10" },
          { "Key": "form-wills-search", "Order": 3, "Title": "Fill out an Application for Search of Wills Notice" },
          { "Key": "form-fill-p2", "Order": 4, "Title": "Fill out a Form P2" }
        ]
      }
    }
  },
  "CDogs": {
    "BaseUrl": "[CDOGS_BASE_URL]",
    "TokenUrl": "[CDOGS_TOKEN_URL]",
    "ClientId": "[CDOGS_CLIENT_ID]",
    "ClientSecret": "[CDOGS_CLIENT_SECRET]"
  },
  "EFiling": {
    "BaseUrl": "[EFiling__BaseUrl]",
    "KeycloakBaseUrl": "[EFiling__KeycloakBaseUrl]",
    "KeycloakRealm": "[EFiling__KeycloakRealm]",
    "ClientId": "[EFiling__ClientId]",
    "ClientSecret": "[EFiling__ClientSecret]",
    "Enabled": true
  }
}